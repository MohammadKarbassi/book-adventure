  "narrative": {
    "northStar": "Paper and Lantern",
    "overview": "This is a source-grounded snapshot of the completed book-material and adventure-interior refinement on 2026-10-22. The existing theme names paper, navy ink, saffron and turquoise; Persian editorial type and physically lit books carry that identity. The material/ending review covers those surfaces only and does not establish whole-page approval.\n\nPRODUCT.md records the user's newer warm, imaginary paper-and-amber illustration direction. That hero and the broader shop hover redesign are pending implementation. The current dark shelf opening and sparse title block are observed state, not approved global composition rules. The shop header remains available on the shelf. Keep this snapshot as evidence while that redesign proceeds; do not treat future imagery as shipped.",
    "keyCharacteristics": [
      "Persian RTL reading and native interactive DOM.",
      "Editorial headings beside legible sans-serif utility text.",
      "Cover-derived rooms and matte, physically modeled books.",
      "Theme-aware shopping and a reversible transition into audio content."
    ],
    "rules": [
      {
        "name": "The Semantic Ink Rule",
        "body": "Pair each themed surface with its corresponding foreground; cover-specific rooms retain their own readable text tone.",
        "section": "colors"
      },
      {
        "name": "The Connected Script Rule",
        "body": "Preserve joined Persian letterforms and RTL reading order; the intro animates Persian words rather than isolated letters.",
        "section": "typography"
      },
      {
        "name": "The Native Reading Rule",
        "body": "Keep text, purchase controls, links and drag anchors in DOM and preserve native scrolling while the canvas provides book imagery.",
        "section": "layout"
      },
      {
        "name": "The Material Truth Rule",
        "body": "Preserve separate cover color, cloth height and matte roughness; do not describe the generated relief as a genuine per-book foil or emboss map.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve semantic theme variables and readable surface/foreground pairs.",
      "**Do** keep Persian RTL reading, logical inline spacing and native interactive DOM.",
      "**Do** preserve cover proportions and separate color, height and roughness maps.",
      "**Do** keep book motion responsive to pointer, keyboard and reduced-motion settings."
    ],
    "donts": [
      "**Don't** copy Stripe artwork, text, fonts or material maps.",
      "**Don't** present generated backs, spines or relief as authentic per-book scans.",
      "**Don't** apply the current dark shelf or sparse hero composition as an approved system-wide template.",
      "**Don't** describe the pending illustrated hero or shop redesign as implemented."
    ]
  }
